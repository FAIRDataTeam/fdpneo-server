# fdp-server configuration — copy to `.env` and adjust.
#
# Values shown match the dev stack in `deploy/compose.yaml`
# (GraphDB + Postgres + Keycloak on localhost). For production,
# replace every value below.
#
# Pydantic-settings loads `.env` automatically. Environment
# variables of the same name override the file.

# --- Top-level -------------------------------------------------------------

ENVIRONMENT=development
BASE_URL=http://localhost:8000
# FDP_NAMESPACE=https://w3id.org/fdp/o#

# --- Postgres (required) ---------------------------------------------------

POSTGRES_DSN=postgresql+asyncpg://fdp:fdp@localhost:5432/fdp

# --- Triple store (required) ----------------------------------------------
# The default below assumes a GraphDB repository named `fdp`. Create it via
# the GraphDB workbench at http://localhost:7200 on first run, or preload it
# via `deploy/graphdb/preload/`.

FDP_TRIPLESTORE_QUERY_ENDPOINT=http://localhost:7200/repositories/fdp
FDP_TRIPLESTORE_UPDATE_ENDPOINT=http://localhost:7200/repositories/fdp/statements
# FDP_TRIPLESTORE_GRAPH_STORE_ENDPOINT=http://localhost:7200/repositories/fdp/rdf-graphs/service
# FDP_TRIPLESTORE_USERNAME=
# FDP_TRIPLESTORE_PASSWORD=
# Backend capability flags (default false; opt in per backend).
# FDP_TRIPLESTORE_SUPPORTS_REPOSITORY_MANAGEMENT=true   # GraphDB
# FDP_TRIPLESTORE_SUPPORTS_NAMED_GRAPH_SYNC=true

# --- OIDC (required) -------------------------------------------------------

FDP_OIDC_ISSUER=http://localhost:8080/realms/fdp-dev
FDP_OIDC_AUDIENCE=fdp
# FDP_OIDC_ROLES_CLAIM=realm_access.roles
# FDP_OIDC_GROUPS_CLAIM=groups
# FDP_OIDC_JWKS_CACHE_TTL_SECONDS=300

# --- CORS (browser cross-origin access) ------------------------------------
# The reference SPA (fdp-client) runs on a different origin than the API, so
# the browser sends a CORS preflight before writes and bearer-authenticated
# reads. List the client origin(s) here — comma-separated or a JSON array.
# The default below is the Vite dev server. In production set this to the
# client's real origin; never use "*" while credentials are allowed.
# FDP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FDP_CORS_ALLOW_CREDENTIALS=true

# --- Metrics ---------------------------------------------------------------
# See ADR-0002 for the privacy design. Identifying data is dropped at ingress
# regardless of these settings.

# FDP_METRICS_ENABLED=true
# FDP_METRICS_UNIQUE_VISITOR_COUNTING=true
# Set to a path that actually contains a MaxMind GeoLite2-City.mmdb.
# Without it, country lookup degrades gracefully to "unknown".
# FDP_METRICS_GEOIP_DATABASE_PATH=/var/lib/fdp/GeoLite2-City.mmdb
# Schedule the `fdp metrics rollup` CLI to match these (see HANDOFF.md):
# FDP_METRICS_AGGREGATE_TO_HOURLY_AFTER_SECONDS=300
# FDP_METRICS_DISCARD_HOURLY_AFTER_DAYS=2
# Run raw→hourly→daily rollups in-process instead of an external `fdp metrics
# rollup` cron. Enable for single-process / dev deployments with no scheduler.
# FDP_METRICS_ROLLUP_IN_PROCESS=false
# FDP_METRICS_ROLLUP_INTERVAL_SECONDS=60

# --- Profile bootstrap -----------------------------------------------------
# When `auto_apply=true` and `path` is set, the lifespan handler applies the
# profile on startup if `profile_applied` is empty. Off by default — apply
# explicitly with `fdp profile apply <path>`.

# FDP_PROFILE_AUTO_APPLY=false
# FDP_PROFILE_PATH=./profiles/default

# --- Data provider ---------------------------------------------------------

# FDP_DATA_DOWNLOAD_MODE=redirect          # or "stream"
# FDP_DATA_PROXY_TIMEOUT_SECONDS=30
# FDP_DATA_PROXY_MAX_BYTES=1073741824      # 1 GiB
