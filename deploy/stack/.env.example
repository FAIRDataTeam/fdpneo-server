# Full-stack deployment configuration. Copy to `.env` and edit.
#
#   cp deploy/stack/.env.example deploy/stack/.env
#
# The defaults below bring the whole stack up on a single host over HTTP at
# localhost. For any other host set PUBLIC_HOST to a name/IP that resolves the
# SAME from the browser AND from inside the containers (a LAN IP or DNS name).
#
# ⚠ Every credential here is a DEVELOPMENT default shipped with the bundled
#   Keycloak realm. Rotate all of them before a real deployment (see README.md).

# Host the browser uses to reach the stack. Must resolve identically inside the
# containers (the server reaches the Keycloak issuer at this host) — `localhost`
# works for a single-host deploy via the docker host-gateway.
PUBLIC_HOST=localhost

# Published host ports (container side is fixed: client 80, server 8000, kc 8080).
# CLIENT_PORT must stay 5173 — the bundled Keycloak realm only allows redirect
# URIs / web origins at http://localhost:5173 (see deploy/keycloak/realm-fdp-dev.json).
CLIENT_PORT=5173
SERVER_PORT=8000
KEYCLOAK_PORT=8081
# MCP bridge (ADR-0018) — the streamable-HTTP MCP endpoint is published here at
# /mcp. Opt-in: the service is behind the `mcp` compose profile (its image is
# not publicly pullable) — enable with `--profile mcp` on the `up` command.
MCP_PORT=8002

# Pinned image tag to pull from GHCR (ignored when building from source).
IMAGE_TAG=main

# Server runtime mode: `production` (strict security) or `development`.
ENVIRONMENT=production

# Serve the interactive API docs UIs (Swagger at /fdp-api/docs, ReDoc at
# /fdp-api/redoc) even in production mode. The machine-readable OpenAPI spec at
# /fdp-api/openapi.json is ALWAYS served regardless of this flag. Default on here
# because this is an evaluation stack; set to false for a real deployment.
EXPOSE_API_DOCS=true

# --- credentials (DEV defaults — ROTATE for production) ---------------------
POSTGRES_USER=fdp
POSTGRES_PASSWORD=fdp
POSTGRES_DB=fdp

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OIDC token audience (the bundled realm stamps `fdp`).
FDP_OIDC_AUDIENCE=fdp

# Confidential service account for the /fdp-api/users IdP-admin facade (ADR-0013).
# Matches the `fdp-server` client in the bundled realm. Rotate the secret + the
# realm client credential together for production.
FDP_IDP_ADMIN_CLIENT_ID=fdp-server
FDP_IDP_ADMIN_CLIENT_SECRET=fdp-server-dev-secret

# Outbound Index ping (Phase 8.1 / ADR-0020/0021). Announce this FDP to one or
# more FDP Index instances so they harvest it and keep it discoverable. Empty by
# default (disabled). Set a comma-separated list of index base URLs to enable;
# the server pings on startup, every FDP_INDEX_PING_INTERVAL_SECONDS (default 7
# days), and on record changes.
# FDP_INDEX_PING_TARGETS=https://home.fairdatapoint.org
# FDP_INDEX_PING_INTERVAL_SECONDS=604800

# External label resolution (Phase 21 / ADR-0012 extension). Let GET /labels
# dereference external IRIs (DOI, ORCID, SKOS vocabularies) over content-
# negotiated RDF and cache the labels in Postgres. Off by default; only hosts on
# the allow-list are fetched. Include the terminal hosts redirect-based conneg
# lands on (DOI -> data.crossref.org / data.datacite.org). ROR is JSON-only and
# not resolved by the generic RDF path.
# FDP_REMOTE_LABELS_ENABLED=true
# FDP_REMOTE_LABELS_ALLOWED_HOSTS=doi.org,api.crossref.org,data.datacite.org,orcid.org,pub.orcid.org
