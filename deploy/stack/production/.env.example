# Single-domain production deployment configuration. Copy to `.env`, set
# PUBLIC_HOST, and replace EVERY `CHANGE-ME` with a real secret
# (e.g. `openssl rand -hex 24` per value) before `docker compose up`.

# The public DNS name this FDP is served at (no scheme, no port). It must
# resolve to this host from the internet — Caddy obtains the TLS certificate
# for it automatically (ports 80+443 must be reachable).
PUBLIC_HOST=fdp.example.org

# Contact for ACME (certificate issuance/expiry notices).
ACME_EMAIL=admin@example.org

# Pinned image tag to pull from GHCR.
IMAGE_TAG=main

# Interactive Swagger/ReDoc UIs (the OpenAPI spec itself is always served).
EXPOSE_API_DOCS=false

# --- secrets (ALL required — the stack refuses to start without them) -------
POSTGRES_USER=fdp
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=fdp

# Keycloak's own database role (created on first boot).
KC_DB_PASSWORD=CHANGE-ME

# Keycloak master-realm admin (the Keycloak admin console at /auth).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE-ME

# Confidential `fdp-server` client secret (the /fdp-api/users facade,
# ADR-0013). Imported into the realm AND handed to the server — one variable,
# both sides stay in sync.
FDP_SERVER_CLIENT_SECRET=CHANGE-ME

# Bootstrap FDP application admin (username `fdp-admin` in the `fdp` realm).
# The password is TEMPORARY — Keycloak forces a change at first login.
FDP_ADMIN_EMAIL=admin@example.org
FDP_ADMIN_INITIAL_PASSWORD=CHANGE-ME

# OIDC token audience (the realm's audience mapper stamps `fdp`).
FDP_OIDC_AUDIENCE=fdp

# --- optional ----------------------------------------------------------------
# Announce this FDP to FDP Index instances (ADR-0020/0021); empty = disabled.
# FDP_INDEX_PING_TARGETS=https://home.fairdatapoint.org

# External label resolution (ADR-0012 extension) — on by default with the
# DOI/ORCID allow-list; see the stack README.
# FDP_REMOTE_LABELS_ENABLED=true
# FDP_REMOTE_LABELS_ALLOWED_HOSTS=doi.org,api.crossref.org,data.crossref.org,data.datacite.org,orcid.org,pub.orcid.org
