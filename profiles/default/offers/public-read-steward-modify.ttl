# Default system-default ODRL Offer for the bundled FDP profile.
#
# Semantics: anyone (including anonymous callers) may read; only callers
# with the role "steward" may modify, delete, or redistribute.
#
# The Offer's IRI is *intrinsic* and deployment-independent. Records
# referencing this Offer via dct:rights use the same IRI regardless of
# what base_url the operator chooses. The applier (see
# fdp.metadata.profiles.applier) stores the graph at this IRI rather
# than at a base_url-derived one for the same reason.
#
# LeftOperand vocabulary:
# * odrl:assignee — standard ODRL party identity.
# * <https://specs.fairdatapoint.org/odrl-profile#role>
# * <https://specs.fairdatapoint.org/odrl-profile#group>
#   (See policy/model.py FDP_PROFILE_NS and ADR-0006.)
#
# Conflict strategy is the FDP default (deny_wins). This Offer has no
# prohibitions so no conflicts arise.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix fdp-pol: <https://specs.fairdatapoint.org/odrl-profile#> .

<https://w3id.org/fdp/profiles/default/offers/public-read-steward-modify>
    a odrl:Offer ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:read
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:modify ;
        odrl:constraint [
            odrl:leftOperand fdp-pol:role ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "steward"
        ]
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:delete ;
        odrl:constraint [
            odrl:leftOperand fdp-pol:role ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "steward"
        ]
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:distribute ;
        odrl:constraint [
            odrl:leftOperand fdp-pol:role ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "steward"
        ]
    ] .
