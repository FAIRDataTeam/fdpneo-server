# Default SHACL shape for dcat:Catalog.
#
# Required: dct:title. Catalogs may aggregate dcat:Dataset and
# dcat:DataService members via dcat:dataset / dcat:service.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dcat:Catalog
    a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    rdfs:label "DCAT Catalog" ;
    rdfs:comment "A curated collection of datasets and data services." ;

    sh:property [
        sh:path dct:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:language ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:description "ODRL Offer governing access to this Catalog." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:description "The Repository (or parent Catalog) this Catalog belongs to." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dcat:themeTaxonomy ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
    ] ;
    sh:property [
        sh:path dcat:dataset ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dcat:service ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .
