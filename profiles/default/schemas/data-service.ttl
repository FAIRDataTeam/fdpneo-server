# Default SHACL shape for dcat:DataService.
#
# Required: dct:title and dcat:endpointURL. A DataService without an
# endpoint isn't actionable, so the URL is mandatory.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dcat:DataService
    a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    rdfs:label "DCAT DataService" ;
    rdfs:comment "A service that provides access to datasets (e.g., SPARQL endpoint, REST API)." ;

    sh:property [
        sh:path dct:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dcat:endpointURL ;
        sh:description "The URL at which the service is invoked." ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dcat:endpointDescription ;
        sh:description "Machine-readable description of the service (e.g., OpenAPI / SPARQL Service Description)." ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dcat:servesDataset ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:description "ODRL Offer governing access to this DataService." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:description "The parent Catalog this DataService belongs to." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .
