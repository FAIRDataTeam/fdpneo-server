# DCAT 3 dcat:DataService = Resource (composed via sh:node) + service properties.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix fs:   <urn:fdp-schema:> .

fs:data-service
    a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    rdfs:label "DCAT Data Service" ;
    sh:node fs:resource ;

    sh:property [
        sh:path dcat:endpointURL ;
        sh:description "The root location or primary endpoint of the service." ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [ sh:path dcat:endpointDescription ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:servesDataset ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:accessService ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .
