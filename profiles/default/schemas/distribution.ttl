# Default SHACL shape for dcat:Distribution.
#
# Required: at least one of dcat:downloadURL or dcat:accessURL — a
# distribution without either is not actionable by the data provider.
# The "at-least-one" constraint is expressed via sh:or so SHACL can
# point at the joint requirement when it fails.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dcat:Distribution
    a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    rdfs:label "DCAT Distribution" ;
    rdfs:comment "A specific representation of a Dataset (file, API response, etc.)." ;

    # At least one of downloadURL or accessURL must be present. Each
    # branch is wrapped as a NodeShape so pyshacl applies it to the
    # focus node uniformly (a property shape inside sh:or also works
    # per spec but produces less-friendly diagnostics).
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path dcat:downloadURL ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path dcat:accessURL ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
            ]
        ]
    ) ;

    sh:property [
        sh:path dct:title ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dcat:downloadURL ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dcat:mediaType ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:format ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dcat:byteSize ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:description "ODRL Offer governing access to this Distribution." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:description "The Dataset this Distribution belongs to." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .
