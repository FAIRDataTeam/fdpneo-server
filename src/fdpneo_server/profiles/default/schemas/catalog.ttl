# DCAT 3 dcat:Catalog ⊑ dcat:Dataset = Dataset (composed) + catalog properties.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fs:   <urn:fdp-schema:> .

fs:catalog
    a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    rdfs:label "DCAT Catalog" ;
    rdfs:comment "A curated collection of datasets and data services." ;
    sh:node fs:dataset ;

    sh:property [ sh:path dcat:dataset ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:service ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:catalog ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:record ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:themeTaxonomy ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path foaf:homepage ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:hasPart ; sh:nodeKind sh:IRI ] .
