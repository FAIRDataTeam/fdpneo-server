# DCAT 3 dcat:Dataset = Resource (composed via sh:node) + dataset properties.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fs:   <urn:fdp-schema:> .

fs:dataset
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    rdfs:label "DCAT Dataset" ;
    sh:node fs:resource ;

    sh:property [
        sh:path dcat:distribution ;
        sh:description "Available distributions of this dataset." ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [ sh:path dct:spatial ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:temporal ] ;
    sh:property [ sh:path dct:accrualPeriodicity ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:temporalResolution ; sh:datatype xsd:duration ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:spatialResolutionInMeters ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path dcat:inSeries ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:description "The catalog (or parent) this dataset belongs to." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .
