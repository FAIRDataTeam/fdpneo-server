# DCAT 3 dcat:Distribution — standalone (not a dcat:Resource subclass).
#
# A representation of a dataset: an accessible/downloadable form. Lenient
# (v0.2): only dct:title is required; DCAT recommends at least one of
# dcat:accessURL / dcat:downloadURL but v0.2 leaves that to the curator.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fs:   <urn:fdp-schema:> .

fs:distribution
    a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    rdfs:label "DCAT Distribution" ;

    # Plain or language-tagged literals; the dash:editor hint keeps the client
    # form builder rendering the field (see resource.ttl for the rationale).
    sh:property [
        sh:path dct:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        dash:editor dash:TextFieldWithLangEditor ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        dash:editor dash:TextAreaWithLangEditor ;
    ] ;
    sh:property [ sh:path dcat:accessURL ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:downloadURL ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:accessService ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:mediaType ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:format ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:byteSize ; sh:datatype xsd:nonNegativeInteger ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:compressFormat ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:packageFormat ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:license ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:rights ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:accessRights ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:conformsTo ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:language ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:issued ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:modified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:temporalResolution ; sh:datatype xsd:duration ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:spatialResolutionInMeters ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path spdx:checksum ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .
