# Default meta-metadata SHACL shape (architecture §6.2).
#
# Every record's sibling <record>/meta graph is validated against this
# shape on every write. Profiles MAY replace this shape but MUST keep
# the FDP-managed fields (dct:created, dct:modified, owl:versionInfo,
# prov:wasGeneratedBy) intact — those are produced by the server itself
# and form the audit baseline.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fdp:  <https://w3id.org/fdp/fdp-o#> .

<urn:fdp-shape:meta-metadata>
    a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:property [
        sh:path dct:created ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path owl:versionInfo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;
    sh:property [
        # Publication state (ADR-0010). Server-managed: set on create
        # (DRAFT for LDP records, PUBLISHED for profile-seeded ones) and
        # changed only via the POST /{record}/state transition API.
        sh:path fdp:metadataState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "DRAFT" "PUBLISHED" "ARCHIVED" ) ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
    ] ;
    sh:property [
        sh:path dct:creator ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        # ADR-0019 §3: the exact profile *version* the record content was
        # validated against at write time. Server-stamped (fdp-o:validatedAgainst),
        # it is the provenance that lets a restore/import reproduce the original
        # validation. Optional — records written before the binding, or writes
        # that don't re-validate, may lack it.
        sh:path fdp:validatedAgainst ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .
