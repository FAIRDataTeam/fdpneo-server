# DCAT 3 dcat:Resource — the reusable base shape (a mixin).
#
# No sh:targetClass: this shape is *composed* into every concrete type via
# sh:node (see dataset/catalog/data-service/…), it does not target records of
# its own. The subject is the urn:fdp-schema: placeholder the applier expands to
# this shape's deployment storage IRI (task 15.2); concrete shapes reference it
# by the same placeholder.
#
# Carries the common DCAT 3 properties of dcat:Resource. Lenient (v0.2): only
# dct:title is required; the rest are optional with datatype / nodeKind
# constraints, so existing records keep validating.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fs:   <urn:fdp-schema:> .

fs:resource
    a sh:NodeShape ;
    rdfs:label "DCAT Resource (base)" ;
    rdfs:comment "Common DCAT 3 properties shared by every cataloged resource." ;

    # Titles/descriptions/keywords accept a plain string OR a language-tagged
    # literal ("…"@en) — DCAT-AP and its health profiles use lang tags
    # routinely, and rdflib types those as rdf:langString, not xsd:string.
    # The dash:editor hint keeps the client's form builder rendering these
    # fields (its shape parser needs a direct constraint or editor on the
    # property shape; it does not descend into sh:or) and lights up its
    # language-aware editor.
    sh:property [
        sh:path dct:title ;
        sh:name "title" ;
        sh:description "Human-readable name of the resource." ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        dash:editor dash:TextFieldWithLangEditor ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        dash:editor dash:TextAreaWithLangEditor ;
    ] ;
    # Agents may be referenced by IRI (preferred: ROR, ORCID, a local agent
    # record) or described inline as a blank node (the DCAT-AP idiom:
    # [ a foaf:Agent ; foaf:name "…" ]).
    sh:property [ sh:path dct:publisher ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path dct:creator ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path dcat:contactPoint ] ;
    sh:property [ sh:path dct:issued ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:modified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [
        sh:path dcat:keyword ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        dash:editor dash:TextFieldWithLangEditor ;
    ] ;
    sh:property [ sh:path dcat:theme ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:language ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:license ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:accessRights ; sh:nodeKind sh:IRI ] ;
    # dct:conformsTo — the validation-bearing binding is server-stamped to the
    # record's type profile (ADR-0019); a record MAY additionally conform to
    # other profiles. Multiple values are allowed (no sh:maxCount).
    sh:property [ sh:path dct:conformsTo ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "identifier" ;
        sh:description "An external identifier for the resource (e.g. a DOI string). The record's own dereferenceable IRI is its persistent identifier; this carries additional, FDP-external ones." ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path adms:identifier ;
        sh:name "alternativeIdentifier" ;
        sh:description "A structured alternative/legacy identifier (an adms:Identifier node with skos:notation). The server records a brought-along foreign IRI here — plus a dct:identifier literal — instead of asserting owl:sameAs when it rebinds a foreign primary subject to the canonical IRI (ADR-0017)." ;
    ] ;
    sh:property [
        sh:path owl:sameAs ;
        sh:name "sameAs" ;
        sh:description "An equivalent IRI for this resource minted elsewhere (a foreign persistent identifier the FDP does not resolve)." ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path skos:exactMatch ;
        sh:name "exactMatch" ;
        sh:description "An IRI asserted to denote the same concept/resource in another vocabulary or registry." ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [ sh:path dcat:landingPage ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path foaf:page ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:type ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:relation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:provenance ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:source ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path dct:rights ;
        sh:description "ODRL Offer governing access to this resource." ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [ sh:path prov:qualifiedAttribution ] ;
    sh:property [ sh:path dcat:qualifiedRelation ] ;

    # DCAT 3 versioning (§9): a resource's place in a version chain.
    sh:property [ sh:path dcat:version ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path adms:versionNotes ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcat:hasVersion ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcat:hasCurrentVersion ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:previousVersion ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:isVersionOf ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:replaces ; sh:nodeKind sh:IRI ] .
